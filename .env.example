# LLM providers
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Provider order: groq (primary) → gemini (fallback) by default
LLM_PRIMARY_PROVIDER=groq

# Model selection
GEMINI_MODEL=gemini-1.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Local embedding model (no API key required)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_OFFLINE_FALLBACK=false

# LLM retry/backoff (per provider)
LLM_MAX_RETRIES=4
LLM_BASE_DELAY_SECONDS=1.0
LLM_MAX_DELAY_SECONDS=20.0
LLM_CACHE_ENABLED=true

# Storage backend: postgres (primary) | sqlite (local/tests)
STORE_BACKEND=postgres
DATABASE_URL=postgresql://factloom:factloom@localhost:5432/factloom

# MinIO / S3 for raw PDFs
S3_ENABLED=true
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=factloom-raw
S3_REGION=us-east-1

# Kafka async upload pipeline
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC_UPLOADS=factloom.uploads
KAFKA_FALLBACK_SYNC=true

# Pipeline versioning
PIPELINE_VERSION=2.0.0
MODEL_PROMPT_VERSION=extract-v2+compare-v2

# Retrieval
RETRIEVAL_VECTOR_K=20
RETRIEVAL_LEXICAL_K=20
RETRIEVAL_FINAL_K=5
RETRIEVAL_SIM_THRESHOLD=0.45
